# Mapillary client token (https://www.mapillary.com/dashboard/developers)
VITE_MAPILLARY_TOKEN=

# 4-digit PIN for the admin panel (Ctrl+Shift+F8 or #admin)
VITE_ADMIN_PIN=

# Address of the online version; the menu shows it as a QR code. Leave empty to hide the QR.
VITE_PUBLIC_URL=

# Shared leaderboard API. The online build uses /api by default; the stand build
# (file://) needs the full address, e.g. https://stajyer-nerede.netlify.app/api.
# Leave empty on the stand to keep scores on this computer only.
VITE_SCORES_API=

# Server only — set these in the Netlify dashboard, never here:
#   MONGODB_URI   MongoDB Atlas connection string
#   MONGODB_DB    database name (default: stajyer-nerede)
